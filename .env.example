# Agent service and hub. Copy to .env for local development, or set these in Dokploy.

# Postgres. In Docker the compose file builds DATABASE_URL from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://agents:change-me@localhost:5432/agents

# The hub uses API_TOKEN; the runner uses RUNNER_TOKEN. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=
RUNNER_TOKEN=

# Runner
AGENTS_API_URL=http://localhost:8080
# Compact JSON from a Codex ChatGPT login cache, transferred securely (never commit it).
# Seeds the runner's dedicated persistent login volume once; refreshed credentials stay there.
CODEX_AUTH_JSON=
# Optional Codex model ID. Blank uses the pinned CLI's default.
CODEX_MODEL=
# Longest a single run may take, in milliseconds.
RUN_TIMEOUT_MS=600000
# Read-only Google Calendar and Gmail for the EA (calendar.readonly, gmail.readonly). A Desktop
# app OAuth client from Google Cloud; get the refresh token with `npm run google-auth -w services/agents`.
# All three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Owner-selected main calendar. Calendar writes stay off until the separate server-only
# credential is granted using google-auth --calendar-write and the switch is enabled.
GOOGLE_WRITE_CALENDAR_ID=
GOOGLE_CALENDAR_WRITE_REFRESH_TOKEN=
GOOGLE_CALENDAR_WRITES_ENABLED=false

PORT=8080

# Hub. Cloudflare Access sits in front of moniqr.com; the hub checks its token on every request.
# Team domain, e.g. yourteam.cloudflareaccess.com, and the AUD tag of the moniqr.com Access app.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated emails allowed into the hub.
HUB_ALLOWED_EMAILS=
# Local development only: skips Cloudflare Access and signs in as this email. Refused in production.
HUB_DEV_EMAIL=
