# Agent service. Copy to .env for local development, or set these in Dokploy.

# Postgres. In Docker the compose file builds DATABASE_URL from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://agents:change-me@localhost:5432/agents

# The hub uses API_TOKEN; the runner uses RUNNER_TOKEN. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=
RUNNER_TOKEN=

# Runner
AGENTS_API_URL=http://localhost:8080
# Long-lived Claude Code token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: model alias for EA runs, e.g. sonnet. Blank uses Claude Code's default.
CLAUDE_MODEL=
# Longest a single run may take, in milliseconds.
RUN_TIMEOUT_MS=600000

PORT=8080
